# ============ 兴趣与账号 ============
# 视频主题词，英文逗号分隔；程序逐个搜索后交错挑选候选。
STUDY_TOPICS=AI,Python,软件工程
# 人设：一句话说明口吻、关注点和表达边界。
STUDY_PERSONA=认真、简短、只谈有依据的视频看点，不装懂

# 接收分享的大号 UID；私信和评论 @ 都发往该账号。
BILI_OWNER_UID=
# 大号准确昵称；评论 @ 模式需要。
BILI_OWNER_NAME=
# 分享方式：private_message=只私信；comment_mention=只在评论 @；both=评论 @ 并私信。
BILI_SHARE_METHOD=private_message

# ============ 互动门槛 ============
# 模型建议后仍需达到的推荐分数（70～100）。
BILI_LIKE_MIN_SCORE=75
BILI_FAVORITE_MIN_SCORE=85
# 收藏夹 ID；留空时查找或创建“学习”收藏夹。
BILI_FAV_FOLDER_ID=

# ============ 运行节奏 ============
# 每轮最多处理的视频数（1～5）。
BILI_BATCH_LIMIT=5
# 启动后首轮视频筛选、以及两轮之间的间隔分钟数（至少 10）。
BILI_RUN_INTERVAL_MINUTES=10
# 每条自己评论下最多自动回复次数（0～3）。
BILI_COMMENT_MAX_REPLIES=3
# 每轮视频最多发表几条公开评论（0～5）；其余入选视频照常点赞、收藏和私信。
BILI_COMMENT_MAX_PER_ROUND=1
# 滚动 24 小时内最多发表几条公开评论（0～50）；用来降低新号被 B 站风控的概率。
BILI_COMMENT_MAX_PER_DAY=3
# 检查新消息的间隔秒数（至少 60）。
BILI_LISTEN_INTERVAL_SECONDS=60
# 每次检查最多自动回复数（1～5）。
BILI_LISTEN_MAX_PER_CYCLE=5
# 每次登录最多自动回复数（1～20）。
BILI_LISTEN_MAX_PER_SESSION=20
# 只处理最近多少小时内的回复和 @ 通知（1～168）；更早的通知只推进游标。
BILI_LISTENER_MAX_AGE_HOURS=24
# 最近一条分享视频的字幕记忆有效小时数（1～24）。
BILI_VIDEO_MEMORY_HOURS=2
# 两次写操作之间的随机等待秒数；下限至少 5。
BILI_WRITE_DELAY_MIN=5
BILI_WRITE_DELAY_MAX=20

# ============ 模型 ============
# OpenAI 兼容接口基础地址，不要带 /chat/completions。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# ============ 安全开关 ============
# true=只生成草稿；确认配置和账号状态后再改为 false。
DRY_RUN=true
# true=要求大号确认收到测试评论的 @ 通知后才允许真实互动。
BILI_REQUIRE_NOTIFICATION_CONFIRMATION=true
