# 喜欢看的视频主题词，用英文逗号分隔；程序会逐个搜索并交错挑选候选视频。
STUDY_TOPICS=AI,Python,软件工程

# 人设说明：用一句话写清口吻、关注点和表达边界；用于视频判断、评论和自动回复。
STUDY_PERSONA=认真、简短、只谈视频中的具体做法，不装懂

# 接收分享的大号 UID；私信和评论区 @ 都发给这个 UID。
BILI_OWNER_UID=
# 大号的准确昵称；仅评论区 @ 模式和 @ 验证命令需要。
BILI_OWNER_NAME=
# 分享方式：private_message=私信视频链接；comment_mention=在评论里 @ 大号。私信失败不会自动改发公开 @。
BILI_SHARE_METHOD=private_message

# 收藏夹 ID；留空时查找或创建名为“学习”的收藏夹。
BILI_FAV_FOLDER_ID=
# 每轮最多处理的视频数，程序强制限制为 1～5。
BILI_BATCH_LIMIT=5
# 两轮视频筛选之间等待的分钟数，从上一轮结束后开始计算；默认和最小值都是 10 分钟。
BILI_RUN_INTERVAL_MINUTES=10
# 每条自己评论下最多自动回复次数，程序强制限制为 0～3。
BILI_COMMENT_MAX_REPLIES=3
# 常驻服务及单独 listen 命令检查新消息的间隔，至少 60 秒。
BILI_LISTEN_INTERVAL_SECONDS=60
# 每次检查最多自动回复的消息总数，范围 1～5。
BILI_LISTEN_MAX_PER_CYCLE=5
# 每次登录最多自动回复的消息总数，范围 1～20；常驻服务达到上限后暂停消息回复，视频轮次继续。
BILI_LISTEN_MAX_PER_SESSION=20
# 最近一条分享视频的字幕可用于后续追问，默认有效 2 小时；范围 1～24 小时。只存本地数据库。
BILI_VIDEO_MEMORY_HOURS=2
# 两次写操作之间的随机等待下限，至少 5 秒。
BILI_WRITE_DELAY_MIN=5
# 两次写操作之间的随机等待上限，不得低于下限。
BILI_WRITE_DELAY_MAX=20

# OpenAI 兼容模型 API 基础地址，不要附加 /chat/completions。
MODEL_BASE_URL=
# 模型 API 密钥；只填本地 .env，不要提交到 Git。
MODEL_API_KEY=
# 模型名称，例如实际服务提供的聊天模型名。
MODEL_NAME=

# 首次保持 true：只生成草稿，不点赞、收藏、发评论或私信；确认配置和验收后再改为 false。
DRY_RUN=true
# 是否要求大号确认收到评论 @ 后才允许真实互动；设为 false 时，扫码登录后直接真实点赞、收藏、评论、私信和回复。
# 更换小号后，如果选择跳过验收，无法保证评论和私信能被大号实际看到。
BILI_REQUIRE_NOTIFICATION_CONFIRMATION=true
